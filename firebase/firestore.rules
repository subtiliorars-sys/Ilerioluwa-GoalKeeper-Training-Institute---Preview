rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function coachDoc() {
      return get(/databases/$(database)/documents/coachRoles/$(request.auth.uid));
    }

    function isActiveCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/coachRoles/$(request.auth.uid))
        && coachDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActiveCoach() && coachDoc().data.role == 'admin';
    }

    function emailKey(email) {
      return email.lower().replace('@', '_at_').replace('.', '_dot_');
    }

    function hasPendingInvite(email) {
      return exists(/databases/$(database)/documents/coachInvites/$(emailKey(email)))
        && get(/databases/$(database)/documents/coachInvites/$(emailKey(email))).data.status == 'pending'
        && get(/databases/$(database)/documents/coachInvites/$(emailKey(email))).data.email == email.lower();
    }

    // Public gallery metadata — read by everyone.
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isActiveCoach()
        && request.resource.data.keys().hasAll(['url', 'caption', 'createdAt'])
        && request.resource.data.url is string
        && request.resource.data.caption is string;
      allow update, delete: if isAdmin();
    }

    // Coach roster — each user reads own profile; admins manage all.
    match /coachRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && hasPendingInvite(request.auth.token.email)
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email.lower();
      allow update, delete: if isAdmin();
    }

    match /coachInvites/{emailKey} {
      allow get: if resource.data.status == 'pending'
        || isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
