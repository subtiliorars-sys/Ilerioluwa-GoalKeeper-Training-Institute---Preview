rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/coachRoles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/coachRoles/$(request.auth.uid)).data.status == 'active'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
